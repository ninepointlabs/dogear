[Desktop Entry]
Type=Application
Name=Dogear
GenericName=PDF and EPUB Reader
Comment=Read, highlight and remember your PDFs.
Exec=dogear %f
Icon=dogear
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;application/epub+zip;
Keywords=pdf;epub;ebook;reader;highlight;annotate;notes;study;textbook;
StartupWMClass=dogear
StartupNotify=true
