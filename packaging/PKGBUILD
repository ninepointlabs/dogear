# Maintainer: Nine Point Labs <tim@ninepointlabs.com>
#
# Builds from the GitHub release tarball. The built package is attached to
# each GitHub release (https://github.com/ninepointlabs/dogear/releases).
pkgname=dogear
pkgver=0.1.2
pkgrel=1
pkgdesc="An Omarchy-native PDF reader for study: highlight, annotate, bookmark, export to Markdown"
arch=('any')
url="https://github.com/ninepointlabs/dogear"
license=('MIT')
depends=(
  'python'
  'pyside6'         # QtQuick and the QtPdf bindings
  'qt6-webengine'   # the Qt PDF library itself (libQt6Pdf)
  'hicolor-icon-theme'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('ghostscript')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('c6bf6eafa53a6da4af1c85a10ecb80efd7055f2dbb904935451cf65c5d7ab40c')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  QT_QPA_PLATFORM=offscreen PYTHONPATH="$PWD/src" python -m unittest discover -s tests
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  install -Dm644 packaging/dogear.desktop "$pkgdir/usr/share/applications/dogear.desktop"
  local size
  for size in 16 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/hicolor/${size}x${size}/apps/dogear.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/dogear.png"
  done
  install -Dm644 packaging/icons/hicolor/scalable/apps/dogear.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dogear.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
